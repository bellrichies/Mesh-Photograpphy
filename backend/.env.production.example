# Mesh Photography - Production Environment Template
# Copy this file to backend/.env on the server and replace every CHANGE_ME value.
# Never commit or upload a real .env into a public document root.

# Application
APP_NAME="Mesh Photography"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mesh-photo.bundly.ng
APP_TIMEZONE=Africa/Lagos

# Database
# On cPanel this usually looks like CPANELUSER_meshphoto and CPANELUSER_meshuser.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_cpanel_database_name
DB_USERNAME=CHANGE_ME_cpanel_database_user
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# JWT
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=CHANGE_ME_64_hex_chars_minimum
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_REFRESH_COOKIE=mesh_refresh_token

# CORS
CORS_ALLOWED_ORIGINS=https://mesh-photo.bundly.ng

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
SESSION_IDLE_TIMEOUT=60
SESSION_FILES_PATH=storage/sessions

# Mail
# Use the SMTP details from your hosting provider or external provider.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_smtp_host
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=CHANGE_ME_smtp_username
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM_ADDRESS=hello@mesh-photo.bundly.ng
MAIL_FROM_NAME="Mesh Photography"

# Admin
ADMIN_PATH=/admin
ADMIN_EMAIL=admin@mesh-photo.bundly.ng
# Required by seed:production. Use a unique password with at least 12 characters.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_initial_admin_password
CSRF_TOKEN_NAME=_token
APP_SETTINGS_CACHE_TTL=300

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_IMAGE_WIDTH=6000
UPLOAD_MAX_IMAGE_HEIGHT=6000
UPLOAD_ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_ALLOWED_DOCUMENT_MIMES=application/pdf
UPLOAD_ALLOWED_VIDEO_MIMES=video/mp4,video/quicktime

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error
