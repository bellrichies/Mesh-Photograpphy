{
  "name": "mesh/photography-platform",
  "description": "Premium photographer portfolio and CMS platform built with custom PHP MVC.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php -r \"echo 'Autoload generated'.PHP_EOL;\""
    ],
    "migrate": "@php database/console.php migrate",
    "migrate:rollback": "@php database/console.php migrate:rollback",
    "migrate:status": "@php database/console.php status",
    "seed:roles-permissions": "@php database/console.php seed:roles-permissions",
    "seed:core-cms": "@php database/console.php seed:core-cms",
    "seed:media-sample": "@php database/console.php seed:media-sample",
    "seed:demo-content": "@php database/console.php seed:demo-content"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
